{
  "name": "@local/dsh-session-import-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Import DeepSeek Harness's own session logs (session.v4.jsonl.zstd) from any folder into this profile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Felix-fyz/dsh-session-import-native.git"
  },
  "homepage": "https://github.com/Felix-fyz/dsh-session-import-native#readme",
  "bugs": {
    "url": "https://github.com/Felix-fyz/dsh-session-import-native/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
